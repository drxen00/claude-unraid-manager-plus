#!/bin/bash
# wraith-terminal-setup — the steps to turn on the Wraith #terminal: a root
# shell on the Unraid host, from your Wraith space (docs/wraith.md).
#
#   wraith-terminal-setup                    print the steps
#   wraith-terminal-setup --authorized-key   print only the authorized_keys line
#
# Run as root (docker exec -it claude-unraid-manager wraith-terminal-setup):
# the key belongs to the watcher, which runs as root, not to Claude's user.
# The container never writes to the host itself: you run the printed commands
# in the Unraid terminal.
set -euo pipefail

state=${WATCH_STATE_DIR:-/workspace/.unraid-watch}
wrapper=/boot/config/claude-unraid/host-shell
container=$(hostname)

if [ "$(id -u)" != 0 ]; then
  echo "wraith-terminal-setup: run it as root: docker exec -it $container wraith-terminal-setup" >&2
  exit 77
fi
if [ "${WRAITH_TERMINAL:-off}" != host ]; then
  echo "wraith-terminal-setup: the terminal is off. Set 'Wraith terminal' to host in the template first, apply, then run this again." >&2
  exit 69
fi
# Claude's user owns /workspace and could put a folder of its own (with its
# own key) in place of the watcher's. So: change into the folder first, check
# the folder we are in is root's and private, and derive the public key from
# the private key in it (the same checks as host-fix-setup).
if [ -L "$state" ] || ! cd -P -- "$state" 2>/dev/null; then
  echo "wraith-terminal-setup: no watcher state folder yet; check: docker logs $container" >&2
  exit 69
fi
if [ "$(stat -c '%u %a' .)" != "0 700" ]; then
  echo "wraith-terminal-setup: $state is not a root-only folder ($(stat -c '%U %a' .)), so its key cannot be trusted." >&2
  echo "wraith-terminal-setup: restart the container; the watcher then moves it aside and makes a new one." >&2
  exit 65
fi
if [ ! -f wraith-terminal-key ] || [ -L wraith-terminal-key ]; then
  echo "wraith-terminal-setup: no terminal key yet; the watcher creates it when it starts with the terminal on. Check: docker logs $container" >&2
  exit 69
fi
pub=$(ssh-keygen -y -f wraith-terminal-key) || { echo "wraith-terminal-setup: cannot read the terminal key" >&2; exit 65; }
line="restrict,pty,command=\"/bin/bash $wrapper\" $pub claude-unraid-manager-wraith-terminal"

if [ "${1:-}" = --authorized-key ]; then
  printf '%s\n' "$line"
  exit 0
fi

cat <<EOF
Wraith terminal: setup

This gives your Wraith space's #terminal a ROOT SHELL on this Unraid server.
Anything you can do in the Unraid web terminal, it can do: the array, disks,
shares, settings, all of it. Only your linked Wraith account can use it, but
whoever runs the Wraith server could in theory type into it as you. Every
command it runs is written to the Unraid syslog (tag claude-wraith-terminal).

Run these in the Unraid terminal as root (Unraid web UI, top right, terminal
icon). The container does not do this for you.

1. Copy the small wrapper script to the flash drive and read it:

   mkdir -p /boot/config/claude-unraid
   docker cp $container:/usr/local/share/claude-unraid-manager/host-shell $wrapper
   less $wrapper

2. Allow the watcher's terminal key to use it:

   echo '$line' >> /root/.ssh/authorized_keys

3. Restart this container. The log then says:
   unraid-watch: Wraith terminal: root shell on <ip> works

   Open #terminal in Wraith (create a channel of type Terminal if needed).

To turn it off: delete that line from /root/.ssh/authorized_keys, or set
'Wraith terminal' back to off in the template.
To see what it ran:  grep claude-wraith-terminal /var/log/syslog
EOF
