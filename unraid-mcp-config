#!/bin/bash
# unraid-mcp-config <path/to/mcp.json>
#
# Adds, refreshes or removes the "unraid" server entry in an MCP config file,
# run as root on every container start (the entrypoint passes
# /etc/claude-code/managed-mcp.json). Other servers in the file are kept.
#
#   UNRAID_API_URL and UNRAID_API_KEY set  → entry written, prints "configured"
#   either missing                         → entry removed, prints "not-configured"
#
# The key is never written to the MCP config. It goes into $UNRAID_MCP_HOME/.env
# (root-owned, mode 0640, group of Claude's user), which runraid reads because
# the entry sets UNRAID_HOME to that directory. The server is runraid (Rust,
# stdio, no listening port) with the atomic projection and only the actions in
# unraid-mcp-tools enabled, unless UNRAID_MCP_TOOLS overrides the list.
#
# Test overrides: UNRAID_MCP_TOOLS_FILE, UNRAID_MCP_BIN, UNRAID_MCP_HOME,
# UNRAID_MCP_GROUP.
set -euo pipefail

dest=${1:?usage: unraid-mcp-config <path/to/mcp.json>}
tools_file=${UNRAID_MCP_TOOLS_FILE:-/usr/local/share/claude-unraid-manager/unraid-mcp-tools}
bin=${UNRAID_MCP_BIN:-/usr/local/bin/runraid}
home=${UNRAID_MCP_HOME:-/run/claude-unraid}
group=${UNRAID_MCP_GROUP:-100}

current='{}'
if [ -s "$dest" ]; then
  if ! current=$(jq -e 'if type == "object" then . else error("not an object") end' "$dest" 2>/dev/null); then
    echo "unraid-mcp-config: $dest is not a JSON object; left unchanged, Unraid MCP not configured." >&2
    exit 1
  fi
fi

write() {
  printf '%s\n' "$1" > "$dest.tmp"
  mv "$dest.tmp" "$dest"
}

if [ -z "${UNRAID_API_URL:-}" ] || [ -z "${UNRAID_API_KEY:-}" ]; then
  if [ "$(jq '(.mcpServers // {}) | has("unraid")' <<< "$current")" = true ]; then
    write "$(jq 'del(.mcpServers.unraid)' <<< "$current")"
  fi
  rm -f "$home/.env"
  echo not-configured
  exit 0
fi

if [ -n "${UNRAID_MCP_TOOLS:-}" ]; then
  tools=$(printf '%s' "$UNRAID_MCP_TOOLS" | tr -d ' \t\n')
else
  tools=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$tools_file" | sed '/^$/d' | paste -sd, -)
fi
if [ -z "$tools" ]; then
  echo "unraid-mcp-config: no actions to enable; Unraid MCP not configured." >&2
  exit 1
fi
case "$UNRAID_API_KEY" in
  *[[:space:]\"\'\\]*)
    echo "unraid-mcp-config: the API key contains whitespace or quotes; Unraid MCP not configured." >&2
    exit 1 ;;
esac

# The key file: created with no access for others before the key is written.
mkdir -p "$home"
chmod 0750 "$home"
( umask 0137; : > "$home/.env.tmp" )
printf 'UNRAID_API_KEY=%s\n' "$UNRAID_API_KEY" > "$home/.env.tmp"
chgrp "$group" "$home" "$home/.env.tmp" 2>/dev/null || true
mv "$home/.env.tmp" "$home/.env"

write "$(jq --arg bin "$bin" --arg tools "$tools" --arg url "$UNRAID_API_URL" --arg home "$home" \
  --arg ca "${UNRAID_API_CA_BUNDLE:-}" '
  .mcpServers.unraid = {
    type: "stdio",
    command: $bin,
    args: ["mcp"],
    env: ({
      UNRAID_API_URL: $url,
      UNRAID_HOME: $home,
      UNRAID_RMCP_PROJECTION: "atomic",
      UNRAID_RMCP_ENABLED_TOOLS: $tools
    } + (if $ca != "" then {UNRAID_API_CA_BUNDLE: $ca} else {} end))
  }' <<< "$current")"
echo configured
